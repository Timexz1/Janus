# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่า (ห้าม commit .env.local)

# OCR — ใช้ที่ฝั่ง server เท่านั้น (อ่าน screenshot ในหน้า "เพิ่มรายการ")
# เลือก provider ได้ใน Settings; key ฝั่ง server จะถูกใช้ก่อน key ที่กรอกในแอปเสมอ

# Gemini OCR — ใช้ Gemini API free tier ได้จาก Google AI Studio
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: เปลี่ยนโมเดล OCR ของ Gemini (ค่าเริ่มต้นในแอปคือ gemini-2.5-flash)
# GEMINI_OCR_MODEL=gemini-2.5-flash

# Typhoon OCR
# ขอ key ฟรี (20 req/min) ที่ https://docs.opentyphoon.ai/  →  playground.opentyphoon.ai
TYPHOON_OCR_API_KEY=

# Supabase — Auth + cloud sync (RLS). ดูค่าได้จาก `npx supabase status` (local)
# หรือ Project Settings → API (cloud)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server เท่านั้น ห้าม import ฝั่ง client

# Origin ที่เชื่อถือได้สำหรับ redirect หลัง login (กัน open-redirect/host-header injection)
# ตั้งใน production ให้เป็นโดเมนจริง เช่น https://janus.example.com — dev เว้นว่างได้
# NEXT_PUBLIC_SITE_URL=
